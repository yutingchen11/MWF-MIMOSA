#!/bin/bash
#SBATCH --job-name=sjob_ablation6
#SBATCH --account=inverse
#SBATCH --partition=rtx6000,rtx8000
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=3
#SBATCH --mem=128G
#SBATCH --time=1-12:00:00
#SBATCH --gpus=1
#SBATCH --array=1-40%20
#SBATCH --output=slurm-%A_%a.out
#SBATCH --mail-type=BEGIN,END,FAIL

set -euo pipefail

cd /autofs/cluster/berkin/yuting/MATLAB/demo/gacelle-main/ANN_EPGXgen20240927/ablation6_loss_stable

CFG_FILE=ablation_list.txt

if [ ! -f "${CFG_FILE}" ]; then
  echo "ERROR: Cannot find ${CFG_FILE}"
  exit 1
fi

# English comment: five random seeds
seed_list=(0 1 2 3 4)

# English comment: number of configs in ablation_list.txt
N_CFG=$(wc -l < "${CFG_FILE}")
N_SEED=${#seed_list[@]}

# English comment: total expected tasks = N_CFG * N_SEED
TOTAL_TASKS=$((N_CFG * N_SEED))

if [ "${SLURM_ARRAY_TASK_ID}" -gt "${TOTAL_TASKS}" ]; then
  echo "ERROR: TaskID ${SLURM_ARRAY_TASK_ID} exceeds TOTAL_TASKS=${TOTAL_TASKS}"
  exit 1
fi

# English comment:
# task_id: 1..100
# convert to zero-based index
TASK0=$((SLURM_ARRAY_TASK_ID - 1))

# English comment:
# cfg cycles fastest, seed changes every N_CFG tasks
CFG_IDX=$((TASK0 % N_CFG + 1))
SEED_IDX=$((TASK0 / N_CFG))

CFG_NAME=$(sed -n "${CFG_IDX}p" "${CFG_FILE}")
SEED=${seed_list[$SEED_IDX]}

if [ -z "${CFG_NAME}" ]; then
  echo "ERROR: Empty cfg name for CFG_IDX=${CFG_IDX}"
  exit 1
fi

echo "Running cfg: ${CFG_NAME}"
echo "Seed: ${SEED}"
echo "CFG_IDX: ${CFG_IDX} / ${N_CFG}"
echo "SEED_IDX: ${SEED_IDX} / ${N_SEED}"
echo "JobID: ${SLURM_JOB_ID}  TaskID: ${SLURM_ARRAY_TASK_ID}"
echo "Node: $(hostname)"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}"
echo "PWD=$(pwd)"

matlab -batch "run_one_loss8_ablation('${CFG_NAME}', ${SEED});"